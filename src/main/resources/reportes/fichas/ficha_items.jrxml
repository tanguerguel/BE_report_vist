<?xml version="1.0" encoding="UTF-8"?>
<!-- Tabla de ítems de una dimensión: enunciado, casillas de nivel 1 a 4 y observaciones. La cabecera se repite en cada página. -->
<jasperReport name="ficha_items" language="java" pageWidth="533" pageHeight="842" columnWidth="533" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="8.0"/>
	<style name="Celda" fontName="DejaVu Sans" fontSize="8.0">
		<box topPadding="3" leftPadding="4" bottomPadding="3" rightPadding="4">
			<pen lineWidth="0.75" lineColor="#111111"/>
		</box>
	</style>
	<style name="Cabecera" style="Celda" mode="Opaque" backcolor="#DDDDDD" bold="true" hTextAlign="Center" vTextAlign="Middle"/>
	<field name="orden" class="java.lang.Integer"/>
	<field name="enunciado" class="java.lang.String"/>
	<columnHeader height="34">
		<element kind="staticText" x="0" y="0" width="298" height="34" style="Cabecera">
			<text><![CDATA[ÍTEMS]]></text>
		</element>
		<element kind="staticText" x="298" y="0" width="108" height="17" style="Cabecera">
			<text><![CDATA[NIVEL]]></text>
		</element>
		<element kind="staticText" x="298" y="17" width="27" height="17" style="Cabecera">
			<text><![CDATA[1]]></text>
		</element>
		<element kind="staticText" x="325" y="17" width="27" height="17" style="Cabecera">
			<text><![CDATA[2]]></text>
		</element>
		<element kind="staticText" x="352" y="17" width="27" height="17" style="Cabecera">
			<text><![CDATA[3]]></text>
		</element>
		<element kind="staticText" x="379" y="17" width="27" height="17" style="Cabecera">
			<text><![CDATA[4]]></text>
		</element>
		<element kind="staticText" x="406" y="0" width="127" height="34" style="Cabecera">
			<text><![CDATA[OBSERVACIONES]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="30" splitType="Prevent">
			<element kind="textField" x="0" y="0" width="298" height="30" markup="styled" textAdjust="StretchHeight" style="Celda">
				<expression><![CDATA["<b>" + $V{REPORT_COUNT} + ".</b> " + net.sf.jasperreports.engine.util.JRStringUtil.xmlEncode($F{enunciado})]]></expression>
			</element>
			<element kind="staticText" x="298" y="0" width="27" height="30" stretchType="ContainerHeight" style="Celda">
				<text><![CDATA[]]></text>
			</element>
			<element kind="staticText" x="325" y="0" width="27" height="30" stretchType="ContainerHeight" style="Celda">
				<text><![CDATA[]]></text>
			</element>
			<element kind="staticText" x="352" y="0" width="27" height="30" stretchType="ContainerHeight" style="Celda">
				<text><![CDATA[]]></text>
			</element>
			<element kind="staticText" x="379" y="0" width="27" height="30" stretchType="ContainerHeight" style="Celda">
				<text><![CDATA[]]></text>
			</element>
			<element kind="staticText" x="406" y="0" width="127" height="30" stretchType="ContainerHeight" style="Celda">
				<text><![CDATA[]]></text>
			</element>
		</band>
	</detail>
</jasperReport>
