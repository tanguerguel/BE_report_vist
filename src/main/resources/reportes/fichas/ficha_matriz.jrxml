<?xml version="1.0" encoding="UTF-8"?>
<!-- Matriz de puntajes: dos dimensiones por fila. Cada fila trae la dimensión izquierda y la derecha (puede faltar). -->
<jasperReport name="ficha_matriz" language="java" pageWidth="533" pageHeight="842" columnWidth="533" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="8.0"/>
	<parameter name="SUB_RANGOS" class="net.sf.jasperreports.engine.JasperReport"/>
	<field name="izquierdaNombre" class="java.lang.String"/>
	<field name="izquierdaMatriz" class="java.util.List"/>
	<field name="derechaNombre" class="java.lang.String"/>
	<field name="derechaMatriz" class="java.util.List"/>
	<detail>
		<band height="30" splitType="Prevent">
			<element kind="subreport" x="0" y="0" width="260" height="20">
				<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($F{izquierdaMatriz})]]></dataSourceExpression>
				<expression><![CDATA[$P{SUB_RANGOS}]]></expression>
				<parameter name="DIMENSION">
					<expression><![CDATA[$F{izquierdaNombre}]]></expression>
				</parameter>
			</element>
			<element kind="subreport" x="273" y="0" width="260" height="20">
				<printWhenExpression><![CDATA[$F{derechaNombre} != null]]></printWhenExpression>
				<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($F{derechaMatriz})]]></dataSourceExpression>
				<expression><![CDATA[$P{SUB_RANGOS}]]></expression>
				<parameter name="DIMENSION">
					<expression><![CDATA[$F{derechaNombre}]]></expression>
				</parameter>
			</element>
		</band>
	</detail>
</jasperReport>
